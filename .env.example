# Copy to .env.local after creating a dedicated KOPPKAS Supabase project.
# Never commit real keys or secret keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: required for Ketua Pemuda account management.
# Never prefix this variable with NEXT_PUBLIC_ and never expose it to client code.
SUPABASE_SERVICE_ROLE_KEY=
