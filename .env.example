# Copy to .env.local after creating a dedicated KOPPKAS Supabase project.
# Never commit real keys or secret keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Preferred server-only key (sb_secret_...). Enables forwarded client-IP rate limiting.
# Enable IP Address Forwarding in Supabase Auth > Rate Limits before relying on it.
SUPABASE_SECRET_KEY=

# Legacy fallback for server-only Auth Admin operations. Never expose in client code.
SUPABASE_SERVICE_ROLE_KEY=
